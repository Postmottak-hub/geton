# Hostinger (LiteSpeed / Apache) SPA, Canonical HTTPS & Caching Configuration
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS and canonical non-www hostname (getontechs.com)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.getontechs\.com$ [NC]
  RewriteRule ^(.*)$ https://getontechs.com/$1 [L,R=301]

  # Serve existing files and directories directly (assets, robots.txt, sitemap.xml, favicons)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all clean SPA paths to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Prevent stale HTML caching across deployments
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Long-lived immutable caching for hashed Vite bundles and static WebP/PNG/SVG assets
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
