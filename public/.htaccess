# Hostinger (LiteSpeed / Apache) Pre-Rendered SEO, SPA Fallback, Canonical HTTPS & Caching Configuration
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS and canonical non-www hostname (getontechs.com)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.getontechs\.com$ [NC]
  RewriteRule ^(.*)$ https://getontechs.com/$1 [L,R=301]

  # Normalize trailing slash on subpaths (e.g. /om-oss/ -> /om-oss) to match canonical URLs
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteRule ^(.+)/$ https://getontechs.com/$1 [L,R=301]

  # Serve existing files directly (assets, robots.txt, sitemap.xml, favicons)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Root domain serves built index.html directly
  RewriteRule ^$ index.html [L]

  # Serve pre-rendered static SEO HTML for clean routes (e.g. /tjenester -> tjenester/index.html)
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Fallback any dynamic or unknown routes to root SPA index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Prevent stale HTML or sitemap caching across deployments
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Long-lived immutable caching for hashed Vite bundles and static WebP/PNG/SVG assets
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
